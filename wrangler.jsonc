{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "sanctuary-rocks",
	"compatibility_date": "2026-10-16",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		// next/image is used in several pages (about, events, crew, artists) -
		// this delegates image resizing to Cloudflare's own image service.
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Opens Backstage Pass. Remove this and redeploy to close the staff area without touching the rest of the site.
	"vars": {
		"STAFF_API_URL": "https://sr2-api-prod.elfavina89.workers.dev"
	}
}
